# ---- SIG Predictions Cup (documented v1 API only) ----
SIG_BASE_URL=https://sig.thesuper.market/api/v1
SIG_API_KEY=            # trade-scope key: used ONLY by the `trader` process
SIG_READ_KEY=           # read-scope key: used by `feeds` and `reporter`
SIG_TOURNAMENT_SLUG=    # e.g. 2026-midterm-elections (see `sigcup bootstrap`)

# ---- Safety ----
LIVE=0                  # 1 = send real orders; anything else = paper mode
KILL_FILE=data/KILL     # touching this file triggers cancel-all + stop

# ---- Storage ----
DSN=sqlite:///data/sigcup.db
DATA_DIR=data

# ---- External data ----
ANTHROPIC_API_KEY=      # stance classification (Haiku 5.5 batch)
X_VENDOR=none           # none | socialdata | twitterapi | official
X_VENDOR_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
YOUTUBE_API_KEY=
FEC_API_KEY=DEMO_KEY
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
